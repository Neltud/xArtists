{
  "mcpServers": {
    "lightning-wallet": {
      "command": "npx",
      "args": ["-y", "lightning-wallet-mcp"],
      "env": {
        "LIGHTNING_WALLET_API_KEY": "${LIGHTNING_WALLET_API_KEY}"
      }
    },
    "xartists": {
      "command": "python3",
      "args": ["packages/xartists-mcp/src/server.py"],
      "env": {
        "XARTISTS_ROOT": "${XARTISTS_ROOT}"
      }
    }
  }
}
