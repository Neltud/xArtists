PORT=8787
CORS_ORIGIN=https://neltud.github.io
MOONPAY_RETURN_URL=https://neltud.github.io/xArtists/
# Configure the matching key pair in the server's secret store; no VITE_ prefix here.
MOONPAY_PUBLIC_KEY=
MOONPAY_SECRET_KEY=
ACCESS_JWT_SECRET=
REQUIRE_SIWX=1
# Creator Studio IPFS: keep OFF until verified SQL migrations 004 and 005,
# wallet-signed test upload and review of Pinata plan/cost. Secrets are server-only.
CREATOR_MEDIA_UPLOAD_ENABLED=0
PINATA_JWT=
DATABASE_URL=
# PGSSL=0 is for local development only. TLS must remain enabled on Render.
# Read-only test on the confirmed hosting service: npm run preflight:studio:ipfs
PULSE_COLLECTION=
# Card Paybox and Stripe checkout remain unavailable until verified payment + delivery.
PAYBOX_ENV=preprod
PAYBOX_SITE=
PAYBOX_RANG=
PAYBOX_HMAC_KEY=
STRIPE_SECRET_KEY=
