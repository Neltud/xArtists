# xArtists frontend — copy to .env.local (never commit secrets)
# Build-time only (Vite). SC flags stay unset until codeHash verified.

# WalletConnect v2 — Cloud project; allow domain neltud.github.io
VITE_WALLETCONNECT_PROJECT_ID=e07ac8e2a212711609b21dade4c9e37f

# Public dApp URL (WC callback / deep links)
# Local: http://localhost:5173
# Prod:  https://neltud.github.io/xArtists
VITE_DAPP_URL=https://neltud.github.io/xArtists

# LIA protocol wallet (public read — not a secret)
# VITE_LIA_PROTOCOL_WALLET=erd1p4zyy5476u5nkw4hprhk6dh63znvksm4ppkxglxqasz2kum0lerqu0crn6

# --- After mainnet deploy + verify_marketplace_codehash.py exit 0 ONLY ---
# VITE_MARKETPLACE_ADDRESS=erd1qqqq...
# VITE_AGENTS_MARKETPLACE_ADDRESS=erd1qqqq...
# VITE_MARKETPLACE_CODEHASH_OK=1
# VITE_AGENTS_CODEHASH_OK=1

# Optional fee display (bps)
# VITE_AGENTS_FEE_BPS=300
# VITE_NFT_MARKET_FEE_BPS=250

# Optional Vite base path for GitHub Pages
# VITE_BASE=/xArtists/
