# Public address of the dedicated Grok trader wallet (mainnet)
GROK_WALLET_ADDRESS=erd1...

# paper | live — live requires PEM + GROK_LIVE_TRADING=1
GROK_MODE=paper
GROK_LIVE_TRADING=0

# Secret — NEVER commit. Only on Vellum/ops host for live.
# GROK_WALLET_PEM_PATH=/secure/path/grok-trader.pem

# Optional API
MVX_API=https://api.multiversx.com

# Reserve / risk (override agent.json)
GROK_MIN_EGLD_RESERVE=1.5
GROK_MAX_RISK_PCT=5
