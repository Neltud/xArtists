{
  "version": "1.2.0",
  "name": "soul-zk-circuit",
  "status": "phase1_onchain_ready",
  "settlement_chain": "multiversx",
  "scheme": {
    "primary": "halo2",
    "primary_id": 1,
    "alternates": ["groth16"],
    "curve": "bn254",
    "bounds": {
      "halo2": {"proof_min": 64, "proof_max": 4096},
      "groth16": {"proof_min": 128, "proof_max": 512},
      "hard_max": 4096,
      "commitment_len": 32,
      "nullifier_min": 16,
      "nullifier_max": 32,
      "vk_hash_len": 32,
      "claim_type_max": 24
    }
  },
  "prover": {
    "enabled": false,
    "endpoint": "",
    "halo2_module": "lia.venues.soul_zk_halo2",
    "timeout_sec": 30,
    "env_flag": "SOUL_ZK_PROVER_ENABLED"
  },
  "verifier": {
    "address": null,
    "chain_id": "1",
    "contract": "contracts/soul-zk-verifier",
    "endpoint_verify": "verifyProof",
    "endpoint_preview": "previewVerify",
    "endpoint_bounds": "getProofBounds",
    "phase": 1,
    "env_address": "SOUL_ZK_VERIFIER_ADDRESS"
  },
  "epoch": {"length_sec": 86400, "source": "unix_day"},
  "circuits": {
    "credit": {
      "id": "soul_credit_v1",
      "public": ["subject", "epoch", "threshold_bps", "nullifier"],
      "private": ["score", "salt"],
      "threshold_bps_default": 5000
    },
    "restake": {
      "id": "soul_restake_v1",
      "public": ["subject", "epoch", "asset_id_hash", "amount_commitment", "nullifier"],
      "private": ["amount", "position_id", "salt"]
    },
    "eligibility": {
      "id": "soul_elig_v1",
      "public": ["subject", "epoch", "cohort_root", "nullifier"],
      "private": ["merkle_path", "leaf_salt"]
    }
  },
  "gates": {
    "size_boost_max": 1.5,
    "yield_unlock_requires": "credit|restake",
    "reject_if_nullifier_seen": true
  },
  "nullifier_store": "data/soul_zk_nullifiers.json",
  "notes": "Bounds tightened v1.2 — scheme-aware; reject gas-waste oversized proofs"
}
